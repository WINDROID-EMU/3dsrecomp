<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameControllerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Top Bar: L, MENU, R -->
    <TextView
        android:id="@+id/btnL"
        android:layout_width="86dp"
        android:layout_height="44dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/gamepad_btn_shoulder"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="L"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnMenu"
        android:layout_width="80dp"
        android:layout_height="34dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:background="@drawable/gamepad_btn_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="MENU"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnR"
        android:layout_width="86dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/gamepad_btn_shoulder"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="R"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Left Controls: Circle Pad (Analog Stick) -->
    <RelativeLayout
        android:id="@+id/circlePadContainer"
        android:layout_width="136dp"
        android:layout_height="136dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="28dp"
        android:layout_marginTop="72dp"
        android:background="@drawable/joystick_base"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/circlePadThumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerInParent="true"
            android:background="@drawable/joystick_thumb" />
    </RelativeLayout>

    <!-- D-Pad (Cross) positioned below Circle Pad -->
    <RelativeLayout
        android:id="@+id/dpadContainer"
        android:layout_width="136dp"
        android:layout_height="136dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnDpadUp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/gamepad_btn_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▲"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnDpadDown"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/gamepad_btn_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▼"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnDpadLeft"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/gamepad_btn_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="◄"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnDpadRight"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/gamepad_btn_circle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="►"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- Right Controls: Action Buttons (ABXY Diamond Layout) -->
    <RelativeLayout
        android:id="@+id/abxyContainer"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="36dp">

        <!-- Top: X (Blue) -->
        <TextView
            android:id="@+id/btnActionX"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/gamepad_btn_x"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="X"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Right: A (Red) -->
        <TextView
            android:id="@+id/btnActionA"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/gamepad_btn_a"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Bottom: B (Yellow) -->
        <TextView
            android:id="@+id/btnActionB"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/gamepad_btn_b"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="B"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Left: Y (Green) -->
        <TextView
            android:id="@+id/btnActionY"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/gamepad_btn_y"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Y"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Bottom Center: Select & Start -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSelect"
            android:layout_width="76dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/gamepad_btn_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="SELECT"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="76dp"
            android:layout_height="32dp"
            android:background="@drawable/gamepad_btn_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
