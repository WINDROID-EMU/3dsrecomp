<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/itemFileIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/badge_background"
        android:gravity="center"
        android:text="C"
        android:textColor="@color/zakuro_badge_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="code000.c"
            android:textColor="@color/zakuro_blue_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemFileDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="245 KB • Modificado hoje"
            android:textColor="@color/zakuro_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/itemActionBtn"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/zakuro_surface_dark"
        android:text="Abrir"
        android:textAllCaps="false"
        android:textColor="@color/zakuro_blue_dark"
        android:textSize="12sp" />
</LinearLayout>
